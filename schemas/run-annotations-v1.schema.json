      "title": "Tags",
      "type": "object"
    },
    "updated_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Updated At"
    }
  },
  "required": [
    "run_id"
  ],
  "title": "RunAnnotations",
  "type": "object"
}
