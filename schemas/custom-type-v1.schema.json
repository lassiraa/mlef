{
  "additionalProperties": false,
  "description": "A namespaced, versioned semantic identity, independent of executable codecs.",
  "properties": {
    "name": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "Name",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "exclusiveMinimum": 0,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "name",
    "version"
  ],
  "title": "CustomType",
  "type": "object"
}
