{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "An exact producer reference, never a mutable latest alias or storage URI.",
      "properties": {
        "output": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Output",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "step",
        "output",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvaluationRow": {
      "additionalProperties": false,
      "properties": {
        "compatibility": {
          "default": "unknown",
          "enum": [
            "declared-compatible",
            "incompatible",
            "unknown"
          ],
          "title": "Compatibility",
          "type": "string"
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "direction": {
          "anyOf": [
            {
              "enum": [
                "maximize",
                "minimize",
                "target",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Direction"
        },
        "duplicate_of": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duplicate Of"
        },
        "eligible": {
          "default": false,
          "title": "Eligible",
          "type": "boolean"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metric_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "observation": {
          "default": "unavailable",
          "enum": [
            "improved",
            "regressed",
            "unchanged",
            "unavailable"
          ],
          "title": "Observation",
          "type": "string"
        },
        "output": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output"
        },
        "rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "relative_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Delta"
        },
        "representation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Representation"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sample_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Count"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scope"
        },
        "split": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "state": {
          "default": "unknown",
          "title": "State",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "EvaluationRow",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "lower": {
          "title": "Lower",
          "type": "number"
        },
        "method": {
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "upper": {
          "title": "Upper",
          "type": "number"
        }
      },
      "required": [
        "lower",
        "upper",
        "confidence",
        "method"
      ],
      "title": "Interval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "baseline_id": {
      "title": "Baseline Id",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "metric": {
      "title": "Metric",
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/EvaluationRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scope": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    }
  },
  "required": [
    "baseline_id",
    "metric",
    "rows"
  ],
  "title": "EvaluationComparison",
  "type": "object"
}
