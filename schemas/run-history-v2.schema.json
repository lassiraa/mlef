{
  "$defs": {
    "Controls": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Applied",
          "type": "object"
        },
        "requested": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Requested",
          "type": "object"
        }
      },
      "title": "Controls",
      "type": "object"
    },
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference"
        }
      },
      "title": "Dataset",
      "type": "object"
    },
    "Evaluation": {
      "additionalProperties": false,
      "properties": {
        "metric_definitions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Metric Definitions",
          "type": "object"
        },
        "protocol_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protocol Id"
        },
        "seeds": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seeds"
        },
        "split_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Split Fingerprint"
        }
      },
      "title": "Evaluation",
      "type": "object"
    },
    "Experiment": {
      "additionalProperties": false,
      "properties": {
        "changed_variables": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Changed Variables",
          "type": "object"
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dataset"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evaluation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Evaluation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hypothesis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hypothesis"
        },
        "metric_directions": {
          "additionalProperties": {
            "enum": [
              "maximize",
              "minimize"
            ],
            "type": "string"
          },
          "title": "Metric Directions",
          "type": "object"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "parent_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Run Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "seeds": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Seeds",
          "type": "object"
        }
      },
      "title": "Experiment",
      "type": "object"
    },
    "GitProvenance": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Branch"
        },
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Commit"
        },
        "dirty": {
          "title": "Dirty",
          "type": "boolean"
        }
      },
      "required": [
        "commit",
        "branch",
        "dirty"
      ],
      "title": "GitProvenance",
      "type": "object"
    },
    "JsonValue": {},
    "RunAnnotations": {
      "additionalProperties": false,
      "properties": {
        "archived": {
          "default": false,
          "title": "Archived",
          "type": "boolean"
        },
        "experiment": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment"
        },
        "experiment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Id"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 20000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tags": {
          "maxProperties": 50,
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_.-]*$": {
              "maxLength": 1000,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 64
          },
          "title": "Tags",
          "type": "object"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "RunAnnotations",
      "type": "object"
    },
    "RunError": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "category",
        "message"
      ],
      "title": "RunError",
      "type": "object"
    },
    "RunRecord": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "controls": {
          "anyOf": [
            {
              "$ref": "#/$defs/Controls"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/RunError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution_exit_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Exit Code"
        },
        "execution_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execution Seconds"
        },
        "experiment": {
          "anyOf": [
            {
              "$ref": "#/$defs/Experiment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "git": {
          "anyOf": [
            {
              "$ref": "#/$defs/GitProvenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceInputs"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/Runtime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": 3,
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "state": {
          "enum": [
            "preparing",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ],
          "title": "State",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "state",
        "created_at",
        "command"
      ],
      "title": "RunRecord",
      "type": "object"
    },
    "Runtime": {
      "additionalProperties": false,
      "properties": {
        "cleanup_pending": {
          "default": false,
          "title": "Cleanup Pending",
          "type": "boolean"
        },
        "container_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Id"
        },
        "container_name": {
          "title": "Container Name",
          "type": "string"
        },
        "probe_name": {
          "title": "Probe Name",
          "type": "string"
        },
        "project": {
          "title": "Project",
          "type": "string"
        },
        "token": {
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "token",
        "project",
        "container_name",
        "probe_name"
      ],
      "title": "Runtime",
      "type": "object"
    },
    "SourceInputs": {
      "additionalProperties": false,
      "properties": {
        "build_recipe_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Recipe Sha256"
        },
        "dependency_hashes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dependency Hashes",
          "type": "object"
        },
        "included_untracked": {
          "items": {
            "type": "string"
          },
          "title": "Included Untracked",
          "type": "array"
        },
        "outputs": {
          "items": {
            "type": "string"
          },
          "title": "Outputs",
          "type": "array"
        },
        "source_sha256": {
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_sha256",
        "included_untracked"
      ],
      "title": "SourceInputs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "additionalProperties": {
        "$ref": "#/$defs/RunAnnotations"
      },
      "title": "Annotations",
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "type": "string"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Offset"
    },
    "runs": {
      "items": {
        "$ref": "#/$defs/RunRecord"
      },
      "title": "Runs",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "total": {
      "title": "Total",
      "type": "integer"
    }
  },
  "required": [
    "runs",
    "diagnostics",
    "total",
    "next_offset",
    "annotations"
  ],
  "title": "RunHistory",
  "type": "object"
}
