{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "An exact producer reference, never a mutable latest alias or storage URI.",
      "properties": {
        "output": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Output",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "step",
        "output",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "An explicit reference to a complete metric JSON payload in a saved artifact.",
  "properties": {
    "aggregation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Aggregation"
    },
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "definition": {
      "minLength": 1,
      "title": "Definition",
      "type": "string"
    },
    "dimensions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Dimensions",
      "type": "object"
    },
    "direction": {
      "default": "none",
      "enum": [
        "maximize",
        "minimize",
        "target",
        "none"
      ],
      "title": "Direction",
      "type": "string"
    },
    "format": {
      "const": "application/json",
      "default": "application/json",
      "title": "Format",
      "type": "string"
    },
    "kind": {
      "const": "external",
      "default": "external",
      "title": "Kind",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parameters",
      "type": "object"
    },
    "path": {
      "title": "Path",
      "type": "string"
    },
    "representation": {
      "enum": [
        "series",
        "table",
        "distribution"
      ],
      "title": "Representation",
      "type": "string"
    },
    "sample_count": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sample Count"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "version": {
      "default": "1",
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "definition",
    "representation",
    "artifact",
    "path"
  ],
  "title": "ExternalMetric",
  "type": "object"
}
