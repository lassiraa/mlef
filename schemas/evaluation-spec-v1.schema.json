{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "An exact producer reference, never a mutable latest alias or storage URI.",
      "properties": {
        "output": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Output",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "step": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Step",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "step",
        "output",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ExternalInput": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "artifact"
      ],
      "title": "ExternalInput",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "bindings": {
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9_-]*$": {
          "$ref": "#/$defs/ExternalInput"
        }
      },
      "title": "Bindings",
      "type": "object"
    },
    "contract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Contract"
    },
    "includes": {
      "items": {
        "type": "string"
      },
      "title": "Includes",
      "type": "array"
    },
    "model_input": {
      "default": "model",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "title": "Model Input",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Parameters",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "script": {
      "title": "Script",
      "type": "string"
    },
    "step": {
      "default": "evaluate",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
      "title": "Step",
      "type": "string"
    }
  },
  "required": [
    "script"
  ],
  "title": "EvaluationSpec",
  "type": "object"
}
