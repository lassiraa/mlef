{
  "$defs": {
    "ArtifactType": {
      "enum": [
        "file",
        "directory",
        "table",
        "dataset",
        "split",
        "predictions",
        "model",
        "checkpoint",
        "metrics",
        "parameters",
        "schema",
        "array",
        "embeddings",
        "index",
        "plot",
        "report",
        "text",
        "image",
        "audio",
        "video",
        "annotations",
        "explanations",
        "archive"
      ],
      "title": "ArtifactType",
      "type": "string"
    },
    "Input": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Format"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/ArtifactType"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "title": "Input",
      "type": "object"
    },
    "Output": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "minLength": 1,
          "title": "Format",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "type": {
          "$ref": "#/$defs/ArtifactType"
        }
      },
      "required": [
        "name",
        "type",
        "format"
      ],
      "title": "Output",
      "type": "object"
    },
    "PipelineDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/PipelineStep"
          },
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "steps"
      ],
      "title": "PipelineDefinition",
      "type": "object"
    },
    "PipelineStep": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "patternProperties": {
            "^[A-Za-z][A-Za-z0-9_-]*$": {
              "type": "string"
            }
          },
          "title": "Bindings",
          "type": "object"
        },
        "contract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "script": {
          "title": "Script",
          "type": "string"
        }
      },
      "required": [
        "name",
        "script"
      ],
      "title": "PipelineStep",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "$ref": "#/$defs/Input"
          },
          "title": "Inputs",
          "type": "array"
        },
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "title": "Name",
          "type": "string"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/Output"
          },
          "minItems": 1,
          "title": "Outputs",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "outputs"
      ],
      "title": "Step",
      "type": "object"
    },
    "ValidationCheck": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "invalid",
            "deferred"
          ],
          "title": "Status",
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        }
      },
      "required": [
        "status",
        "code",
        "message"
      ],
      "title": "ValidationCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/ValidationCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "contracts": {
      "additionalProperties": {
        "$ref": "#/$defs/Step"
      },
      "title": "Contracts",
      "type": "object"
    },
    "definition": {
      "anyOf": [
        {
          "$ref": "#/$defs/PipelineDefinition"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "order": {
      "items": {
        "type": "string"
      },
      "title": "Order",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "verified",
        "invalid",
        "deferred"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "title": "ValidationReport",
  "type": "object"
}
