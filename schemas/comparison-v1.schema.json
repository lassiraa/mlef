            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline"
        },
        "candidate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate"
        },
        "compatibility": {
          "enum": [
            "declared-compatible",
            "incompatible",
            "unknown"
          ],
          "title": "Compatibility",
          "type": "string"
